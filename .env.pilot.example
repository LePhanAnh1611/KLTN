# ===== Cấu hình đợt PILOT (người dùng thật) — copy thành .env.pilot rồi điền =====
# .env.pilot chứa mật khẩu -> KHÔNG commit (đã có trong .gitignore).
# Chạy: scripts/pilot/start.ps1  (xem docs/PILOT.md)

# Project compose riêng -> volume DB riêng, không lẫn dữ liệu dev/demo
COMPOSE_PROJECT_NAME=learninghub-pilot

POSTGRES_USER=dkt_user
POSTGRES_PASSWORD=doi-mat-khau-manh
POSTGRES_DB=dkt_pilot
POSTGRES_PORT=5434

JWT_SECRET_KEY=python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_ALGORITHM=HS256
# 14 ngày: người học mở app mỗi ngày không phải đăng nhập lại
ACCESS_TOKEN_EXPIRE_MINUTES=20160

# Để TRỐNG: trình duyệt gọi /api cùng địa chỉ với trang (nginx chuyển tiếp)
VITE_API_BASE_URL=
# 8090 chứ không 5173: cổng 5173 thường đã bị vite dev chiếm trên máy dev
FRONTEND_PORT=8090
BACKEND_PORT=8000
ML_SERVE_PORT=8001
# Địa chỉ công khai (link Cloudflare) — dùng trong email xác thực/quên mật khẩu
CORS_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173

DKT_VARIANT=feature
INSTALL_SPEAKING=false
INSTALL_PDF_IMPORT=false
SCHEDULER_ENABLED=true

# ===== EMAIL — gửi thật quên mật khẩu / xác thực email =====
# Cách bật (chỉ 4 dòng):
#   1. Gmail gửi: bật Xác minh 2 bước -> myaccount.google.com/apppasswords tạo mật khẩu ứng dụng
#   2. EMAIL_BACKEND=smtp
#   3. EMAIL_FROM và SMTP_USER = cùng địa chỉ Gmail đó
#   4. SMTP_PASSWORD = mật khẩu ứng dụng 16 ký tự (viết liền, không dấu cách)
# rồi chạy update-pilot.bat. Nhắc ôn / thông báo / báo cáo pilot vẫn chỉ ghi log,
# vì EMAIL_REAL_TEMPLATES chỉ cho 2 loại dưới đây đi ra ngoài ("*" = tất cả).
EMAIL_BACKEND=log
EMAIL_FROM=no-reply@dktvocab.local
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_REAL_TEMPLATES=password_reset,email_verify

# Ngày bắt đầu tính dữ liệu pilot (trước đó là chạy thử, không tính)
PILOT_START_DATE=2026-10-16
# Email nhận báo cáo lúc 21h (tùy chọn). Báo cáo luôn được ghi ra pilot_reports/latest.txt
PILOT_REPORT_EMAIL=

GROQ_API_KEY=
