# PostgreSQL
POSTGRES_USER=dkt_user
POSTGRES_PASSWORD=dkt_pass
POSTGRES_DB=dkt_vocab
POSTGRES_PORT=5433

# Backend
DATABASE_URL=postgresql+psycopg://dkt_user:dkt_pass@localhost:5433/dkt_vocab
TEST_DATABASE_URL=postgresql+psycopg://dkt_user:dkt_pass@localhost:5433/dkt_vocab_test

# JWT (generate your own secret: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET_KEY=change-me-in-your-local-.env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Nguồn được phép gọi API (CORS). Chạy tay: vite dev ở 5173.
CORS_ORIGINS=http://localhost:5173

# DKT serve (UC-68)
ML_SERVE_URL=http://localhost:8001
ML_SERVE_PORT=8001

# Cổng publish khi chạy bằng docker compose
BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

# UC-62 gửi email: 'log' (chỉ ghi log, mặc định) hoặc 'smtp'
EMAIL_BACKEND=log
# EMAIL_FROM=no-reply@dktvocab.local
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# UC-62/63 tác vụ nền — đặt false nếu muốn tự chạy bằng cron/Task Scheduler
SCHEDULER_ENABLED=true

# ---- Module luyện nói (tùy chọn) ----
# true = cài faster-whisper vào image backend (+~200MB). Xem docs/speaking-module.md
INSTALL_SPEAKING=false
# Ollama chạy trên máy host; trong docker phải gọi qua host.docker.internal
SPEAKING_OLLAMA_URL=http://host.docker.internal:11434
SPEAKING_OLLAMA_MODEL=qwen2.5:7b
SPEAKING_WHISPER_MODEL=base

# ---- LLM qua Groq Cloud (thay Ollama local) ----
# Lấy key ở https://console.groq.com/keys — KHÔNG commit key thật vào repo.
# Dùng cho: chấm C3/C4 module luyện nói, gắn chủ đề PDF (UC-87), hội thoại AI (UC-39).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
